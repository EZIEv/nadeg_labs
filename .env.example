# Copy to .env; keep credentials on the server only.
OPENROUTER_API_KEY=
# Must accept text + images. Students never choose or submit the model.
OPENROUTER_MODEL=openai/gpt-6-luna
# json_schema (recommended), json_object, or prompt; output is always validated.
OPENROUTER_RESPONSE_FORMAT=json_schema
OPENROUTER_MAX_TOKENS=6000
OPENROUTER_TIMEOUT=120
NADEG_AI_PER_IP_HOUR=6
NADEG_AI_TOTAL_HOUR=30
